# Copy to server/.env.local and supply your own credentials.
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT
API_PORT=3001
API_HOST=127.0.0.1
# Set to the deployed frontend origin when the API is hosted separately.
FRONTEND_ORIGIN=

NANSEN_API_KEY=YOUR_NANSEN_API_KEY
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
